rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['kunlathat.aum@gmail.com'];
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // ข้อมูลส่วนตัวของแต่ละคน (โปรไฟล์ + ข้อมูลรายเดือน)
    match /data/users/{uid}/{docId} {
      allow read, write: if isSelf(uid);
    }
    // ลูกค้าที่แชร์ข้อมูลกับโค้ช: เจ้าของกับโค้ชเท่านั้น
    match /clients/{uid} {
      allow read, write: if isSelf(uid) || isCoach();
    }
    match /clients/{uid}/data/{docId} {
      allow read, write: if isSelf(uid) || isCoach();
    }
    // แม่น้ำลอยกระทงรวม: ทุกคนที่ล็อกอินอ่านได้ แต่เขียนได้เฉพาะของตัวเอง
    match /river/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && request.resource.data.krathongs.size() <= 12;
      allow delete: if isSelf(uid) || isCoach();
    }
  }
}
